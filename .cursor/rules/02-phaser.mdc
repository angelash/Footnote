# Phaser 3 开发规范

## 场景结构

### 场景生命周期
```typescript
export class GameScene extends Phaser.Scene {
  constructor() {
    super({ key: 'GameScene' });
  }

  // 1. 初始化（接收传递的数据）
  init(data: ISceneData): void {
    this._zoneId = data.zoneId;
  }

  // 2. 预加载资源（PreloadScene已加载的不需要）
  preload(): void {
    // 仅加载本场景特有资源
  }

  // 3. 创建游戏对象
  create(): void {
    this._setupWorld();
    this._setupUI();
    this._setupEvents();
  }

  // 4. 更新循环
  update(time: number, delta: number): void {
    this._player?.update(time, delta);
  }

  // 5. 清理（场景切换时）
  shutdown(): void {
    this._cleanup();
  }
}
```

### 标准场景列表
```typescript
// src/scenes/index.ts
export const SCENES = {
  BOOT: 'BootScene',        // 启动检查
  PRELOAD: 'PreloadScene',  // 资源预加载
  MENU: 'MenuScene',        // 主菜单
  GAME: 'GameScene',        // 游戏主场景
  UI: 'UIOverlay',          // UI覆盖层（并行运行）
} as const;
```

## 资源管理

### PreloadScene 统一加载
```typescript
export class PreloadScene extends Phaser.Scene {
  preload(): void {
    // 显示加载进度
    this._createLoadingBar();

    // 图片资源
    this.load.image('bg_c0z1', 'assets/images/backgrounds/c0-z1.svg');
    this.load.spritesheet('player', 'assets/images/characters/player.png', {
      frameWidth: 64,
      frameHeight: 64,
    });

    // 音频资源
    this.load.audio('bgm_main', 'assets/audio/bgm/main.mp3');

    // 数据文件
    this.load.yaml('dialogues_c0', 'assets/data/dialogues/c0.yaml');
    this.load.json('cards', 'assets/data/cards.json');
  }

  create(): void {
    // 初始化全局资源后跳转
    this.scene.start(SCENES.MENU);
  }
}
```

### 资源键命名规范
```typescript
// 图片: {type}_{identifier}
'bg_c0z1'           // 背景
