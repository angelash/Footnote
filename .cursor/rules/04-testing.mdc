### 测试结构
```typescript
// DialogueManager.test.ts
import { describe, it, expect, beforeEach, vi } from 'vitest';
import { DialogueManager } from './DialogueManager';

describe('DialogueManager', () => {
  let manager: DialogueManager;

  beforeEach(() => {
    manager = new DialogueManager();
  });

  describe('start', () => {
    it('应该加载指定对话并触发start事件', async () => {
      const onStart = vi.fn();
      manager.on('start', onStart);

      await manager.start('C0_Z1_ENTRY');

      expect(onStart).toHaveBeenCalledWith(
        expect.objectContaining({ id: 'C0_Z1_ENTRY' })
      );
    });

    it('应该在对话不存在时抛出错误', async () => {
      await expect(manager.start('INVALID_ID'))
        .rejects.toThrow('Dialogue not found');
    });
  });

  describe('choose', () => {
    it('应该正确处理分支选择', async () => {
      await manager.start('C0_Z1_CHOICE_1');
      await manager.choose(0);

      expect(manager.getCurrentDialogue().id).toBe('C0_Z1_FLOW');
    });

    it('选择无收益选项应增加R值', async () => {
      const worldState = { counters: { r: 0, p: 0, w: 100 } };
      manager = new DialogueManager({ worldState });

      await manager.start('C0_Z1_CHOICE_1');
      await manager.choose(1);  // 选择"先看看周围"

      expect(worldState.counters.r).toBe(1);
    });
  });
});
```

