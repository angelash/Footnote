### 流程测试示例
```typescript
// tests/e2e/prologue.spec.ts
import { test, expect } from '@playwright/test';

test.describe('序章流程', () => {
  test.beforeEach(async ({ page }) => {
    await page.goto('/');
    // 跳过启动动画
    await page.click('[data-testid="skip-intro"]');
  });

  test('C0-Z1: 宿舍走廊基本流程', async ({ page }) => {
    // 进入游戏
    await page.click('[data-testid="start-game"]');

    // 等待场景加载
    await expect(page.locator('[data-testid="zone-title"]'))
      .toHaveText('宿舍走廊');

    // 查看身份卡
    await page.click('[data-testid="identity-card"]');
    await expect(page.locator('[data-testid="card-popup"]'))
      .toBeVisible();
    await expect(page.locator('[data-testid="card-title"]'))
      .toContainText('岑回');

    // 关闭卡片
    await page.click('[data-testid="card-close"]');

    // 验证卡片已收集
    await page.click('[data-testid="inventory-button"]');
    await expect(page.locator('[data-testid="card-list"]'))
      .toContainText('身份识别卡');
  });

  test('C0-Z2: 无收益选择应增加R值', async ({ page }) => {
    await page.click('[data-testid="start-game"]');

    // 导航到C0-Z2
    await page.click('[data-testid="exit-to-c0z2"]');

    // 选择"今日特别"（无收益选项）
    await page.click('[data-testid="order-special"]');

    // 验证R值增加（需要开发者工具或状态显示）
    const rValue = await page.evaluate(() => {
      return window.__DEBUG_STATE__?.counters.r;
    });
    expect(rValue).toBe(1);
  });
});
```

