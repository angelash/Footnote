## 自动化测试脚本

### ChromeMCP 集成
```typescript
// scripts/run-e2e-with-mcp.ts
import { chromium } from 'playwright';

async function runWithChromeMCP() {
  // 启动开发服务器
  const server = await startDevServer();

  // 连接到ChromeMCP管理的浏览器
  const browser = await chromium.connectOverCDP('http://localhost:9222');

  try {
    const page = await browser.newPage();
    await page.goto('http://localhost:5173');

    // 运行测试场景
    await runTestScenarios(page);

    console.log('✅ 所有测试通过');
  } catch (error) {
    console.error('❌ 测试失败:', error);
    process.exit(1);
  } finally {
    await browser.close();
    server.close();
  }
}
```

### WindowsMCP 回归测试
```typescript
// scripts/regression-test.ts
import { exec } from 'child_process';

async function runRegressionWithWindowsMCP() {
  // 构建生产版本
  await execPromise('npm run build');

  // 启动本地服务器
  await execPromise('npx serve dist -p 8080 &');

  // 通过WindowsMCP执行测试
  // WindowsMCP会处理浏览器启动和截图对比
  await execPromise('npx playwright test --project=regression');

  console.log('回归测试完成');
}
```

