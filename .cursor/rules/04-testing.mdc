## 核心系统测试用例

### WorldState 测试
```typescript
describe('WorldState', () => {
  describe('R值计算', () => {
    it('完成无收益行为应增加R', () => {
      const state = new WorldState();
      state.recordAction({ type: 'no_reward', id: 'signpost_fix', rValue: 2 });
      expect(state.counters.r).toBe(2);
    });

    it('R≥3时应触发系统停顿标记', () => {
      const state = new WorldState();
      state.counters.r = 3;
      expect(state.shouldShowSystemPause()).toBe(true);
    });

    it('R≥6时应触发F21弱版', () => {
      const state = new WorldState();
      state.counters.r = 6;
      expect(state.shouldTriggerF21Weak()).toBe(true);
    });
  });

  describe('P值计算', () => {
    it('深度介入应增加P值', () => {
      const state = new WorldState();
      state.useAbility('DEPTH_INTERVENTION');
      expect(state.counters.p).toBe(2);
    });

    it('时间干预应增加更多P值', () => {
      const state = new WorldState();
      state.useAbility('TIME_INTERVENTION');
      expect(state.counters.p).toBe(3);
    });
  });

  describe('结局判定', () => {
    it('低干预应得到结局A', () => {
      const state = new WorldState();
      state.counters = { r: 2, p: 5, w: 80 };
      expect(state.determineEnding()).toBe('A_STABLE_PLANE');
    });

    it('高压力低可读性应得到结局B', () => {
      const state = new WorldState();
      state.counters = { r: 5, p: 25, w: 20 };
      expect(state.determineEnding()).toBe('B_RELEASE_TRUTH');
    });

    it('特定条件应触发隐藏结局C', () => {
      const state = new WorldState();
      state.counters = { r: 12, p: 18, w: 35 };
      expect(state.determineEnding()).toBe('C_BECOME_SYSTEM');
    });
  });
});
```

### 伏笔系统测试
```typescript
describe('ForeshadowTracker', () => {
  describe('伏笔触发', () => {
    it('应按顺序触发伏笔阶段', () => {
      const tracker = new ForeshadowTracker();

      // 首次投放
      tracker.trigger('F01', 'plant');
      expect(tracker.getState('F01').planted).toBe(true);

      // 加深
      tracker.trigger('F01', 'deepen');
      expect(tracker.getState('F01').deepened).toBe(true);
    });

    it('不应跳过前置阶段', () => {
      const tracker = new ForeshadowTracker();

      // 未plant直接deepen应失败
      expect(tracker.canTrigger('F01', 'deepen')).toBe(false);
    });
  });

  describe('终局验证', () => {
    it('应检测未回收的伏笔', () => {
      const tracker = new ForeshadowTracker();
      tracker.trigger('F01', 'plant');
      tracker.trigger('F01', 'deepen');
      // F01未resolve

      const result = tracker.validateEndgame();
      expect(result.valid).toBe(false);
      expect(result.unresolvedForeshadows).toContain('F01');
    });
  });
});
```

### 卡片系统测试
```typescript
describe('CardSystem', () => {
  describe('卡片收集', () => {
    it('应正确收集卡片', () => {
      const system = new CardSystem();
      system.collect('CARD_C0_01');

      expect(system.has('CARD_C0_01')).toBe(true);
      expect(system.getAll().length).toBe(1);
    });

    it('不应重复收集同一卡片', () => {
      const system = new CardSystem();
      system.collect('CARD_C0_01');
      system.collect('CARD_C0_01');

      expect(system.getAll().length).toBe(1);
    });
  });

  describe('卡片状态', () => {
    it('接受疗程应覆盖卡片状态', () => {
      const system = new CardSystem();
      system.collect('CARD_C5_02');
      system.updateState('CARD_C5_02', 'aligned');

      const card = system.get('CARD_C5_02');
      expect(card.currentState).toBe('aligned');
    });
  });
});
```

