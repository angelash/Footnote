## 十一、URL提取与下载脚本

### 11.1 提取URL的JavaScript
```javascript
() => {
  const images = document.querySelectorAll('img');
  const urls = [];
  images.forEach(img => {
    if (img.src.includes('storage_out') && img.src.includes('_small.webp')) {
      urls.push(img.src);
    }
  });
  return [...new Set(urls)];
}
```

### 11.2 Python下载脚本模板
```python
import requests
import os
from datetime import datetime

def download_and_audit(urls, asset_type, asset_name, save_dir):
    """下载图片并进行审核分类"""
    os.makedirs(f'{save_dir}/approved', exist_ok=True)
    os.makedirs(f'{save_dir}/rejected', exist_ok=True)
    
    results = []
    for i, url in enumerate(urls, 1):
        response = requests.get(url, timeout=30)
        filename = f'{asset_name}_v1_{i}.webp'
        temp_path = f'{save_dir}/{filename}'
        
        with open(temp_path, 'wb') as f:
            f.write(response.content)
        
        # 返回文件信息供审核
        results.append({
            'file': filename,
            'path': temp_path,
            'size': len(response.content)
        })
    
    return results
```

