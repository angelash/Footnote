```python
# comics/scripts/generate_comic.py

import asyncio
from pathlib import Path

class ComicGenerator:
    def __init__(self, episode_id: str):
        self.episode_id = episode_id
        self.script_path = Path(f"comics/scripts/{episode_id}")
        self.output_path = Path(f"comics/generated/{episode_id}")
        
    async def generate_all_panels(self):
        """生成该话所有分镜"""
        storyboard = self.load_storyboard()
        
        for page in storyboard["pages"]:
            for panel in page["panels"]:
                await self.generate_panel(panel)
                await asyncio.sleep(5)  # 避免请求过快
                
    async def generate_panel(self, panel: dict):
        """生成单个分镜"""
        prompt = self.build_prompt(panel)
        
        # 调用智绘API
        result = await self.call_zhihui(prompt)
        
        # 质量检查
        if self.check_quality(result, panel):
            self.save_approved(result, panel["panel_id"])
        else:
            self.save_rejected(result, panel["panel_id"])
            self.queue_retry(panel)
            
