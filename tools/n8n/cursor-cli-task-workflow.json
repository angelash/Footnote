  "nodes": [
    {
      "parameters": {},
      "id": "trigger-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "task_pack_path",
              "stringValue": "docs/03_taskpacks/T-0001_example.md"
            },
            {
              "name": "role",
              "stringValue": "L3_writer"
            },
            {
              "name": "project_root",
              "stringValue": "/home/shash/work/Footnote"
            },
            {
              "name": "wsl_user",
              "stringValue": "shash"
            }
          ]
        },
        "options": {}
      },
      "id": "set-task-params",
      "name": "Set Task Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [470, 300]
    },
    {
      "parameters": {
        "filePath": "={{ $json.project_root }}/{{ $json.task_pack_path }}",
        "options": {}
      },
      "id": "read-task-pack",
      "name": "Read Task Pack",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [690, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse Task Pack and build minimal context\nconst data = $input.first();\nlet text = '';\n\nif (data.binary?.data?.data) {\n  text = Buffer.from(data.binary.data.data, 'base64').toString('utf8');\n}\n\n// Extract key sections\nconst sections = {\n  raw_content: text,\n  task_id: 'T-0001',\n  project_root: $('Set Task Parameters').first().json?.project_root,\n  task_pack_path: $('Set Task Parameters').first().json?.task_pack_path,\n  role: $('Set Task Parameters').first().json?.role\n};\n\n// Build cursor prompt file\nconst cursorPrompt = `\n# Task Execution Instructions\n\n## Current Role: ${sections.role}\n\n## Task Pack:\n${text}\n\n## Execution Rules:\n1. Only read files listed in Allowed Inputs\n2. Only write to paths listed in Deliverables\n3. Follow all constraints strictly\n4. Output a receipt in this format:\n\n【完成内容】\n- List completed items\n\n【输出文件】\n- List created/modified files\n\n【自检】\n- [ ] Checklist items verified\n\n【风险与未完成】\n- Any risks or incomplete items\n`;\n\nreturn { json: { ...sections, cursor_prompt: cursorPrompt } };"
      },
      "id": "build-prompt",
      "name": "Build Cursor Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [910, 300]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $json.project_root }}/.cursor/current_task_prompt.md",
        "fileContent": "={{ $json.cursor_prompt }}",
        "options": {}
      },
      "id": "write-prompt",
      "name": "Write Prompt File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [1130, 300]
    },
    {
      "parameters": {
        "command": "cd {{ $('Set Task Parameters').first().json.project_root }} && ~/.local/bin/cursor-agent --print --force --approve-mcps --output-format text \"$(cat .cursor/current_task_prompt.md)\"",
        "options": {
          "cwd": "={{ $('Set Task Parameters').first().json.project_root }}"
        }
      },
      "id": "execute-cursor",
      "name": "Execute Cursor CLI",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1350, 300],
      "notes": "Requires cursor-agent in WSL: ~/.local/bin/cursor-agent. Project must be in WSL filesystem (not /mnt/)."
    },
    {
      "parameters": {
        "command": "cd {{ $('Set Task Parameters').first().json.project_root }} && npm run validate --if-present 2>&1 || echo 'No validator configured'",
        "options": {
          "cwd": "={{ $('Set Task Parameters').first().json.project_root }}"
        }
      },
      "id": "run-validators",
      "name": "Run Validators",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1570, 300]
    },
    {
      "parameters": {
        "jsCode": "// Check validation results\nconst validatorOutput = $input.first().json?.stdout || '';\nconst validatorError = $input.first().json?.stderr || '';\nconst exitCode = $input.first().json?.exitCode || 0;\n\nconst passed = exitCode === 0 && !validatorError.includes('error') && !validatorError.includes('FAIL');\n\nreturn {\n  json: {\n    task_id: $('Build Cursor Prompt').first().json?.task_id,\n    validation_passed: passed,\n    validator_output: validatorOutput,\n    validator_error: validatorError,\n    status: passed ? 'PENDING_REVIEW' : 'FAILED_VALIDATION'\n  }\n};"
      },
      "id": "check-validation",
      "name": "Check Validation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1790, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "validation-check",
              "leftValue": "={{ $json.validation_passed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-validated",
      "name": "Validation OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2010, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "status",
              "value": "AWAITING_REVIEW",
              "type": "string"
            },
            {
              "name": "message",
              "value": "Task completed validation, awaiting human review",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-review-status",
