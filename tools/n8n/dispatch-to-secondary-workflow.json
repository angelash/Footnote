{
  "name": "Dispatch Task to Secondary (WSL Runner)",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dispatch-task",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "trigger-webhook",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 120]
    },
    {
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "task_pack_path",
              "stringValue": "={{ $json.body?.task_pack_path || 'docs/03_taskpacks/T-0001_c0_z1_dialogue.md' }}"
            },
            {
              "name": "role",
              "stringValue": "={{ $json.body?.role || 'L3_writer' }}"
            },
            {
              "name": "task_type",
              "stringValue": "={{ $json.body?.task_type || 'doc' }}"
            },
            {
              "name": "complexity",
              "stringValue": "={{ $json.body?.complexity || 'normal' }}"
            },
            {
              "name": "model_override",
              "stringValue": "={{ $json.body?.model_override || 'auto' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-params",
      "name": "Set Dispatch Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5680/webhook/execute-task",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"task_pack_path\": $json.task_pack_path, \"role\": $json.role, \"task_type\": $json.task_type, \"complexity\": $json.complexity, \"model_override\": $json.model_override}",
        "options": {}
      },
      "id": "http-dispatch",
      "name": "HTTP Dispatch to Secondary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300],
      "notes": "Requires secondary workflow to be ACTIVE and expose Webhook path /webhook/execute-task"
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Set Dispatch Payload", "type": "main", "index": 0 }]]
    },
    "Webhook Trigger": {
      "main": [[{ "node": "Set Dispatch Payload", "type": "main", "index": 0 }]]
    },
    "Set Dispatch Payload": {
      "main": [[{ "node": "HTTP Dispatch to Secondary", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [{ "name": "AI-Native" }, { "name": "Dispatch" }]
}


