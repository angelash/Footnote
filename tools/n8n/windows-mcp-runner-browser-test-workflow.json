{
  "name": "Windows MCP Runner (Browser Test)",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "browser-test",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "trigger-webhook",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "mcp_url",
              "stringValue": "={{ $json.body?.mcp_url || $env.MCP_URL || 'http://localhost:3000/mcp' }}"
            },
            {
              "name": "task_type",
              "stringValue": "={{ $json.body?.task_type || 'browser-test' }}"
            },
            {
              "name": "complexity",
              "stringValue": "={{ $json.body?.complexity || 'normal' }}"
            },
            {
              "name": "model_override",
              "stringValue": "={{ $json.body?.model_override || '' }}"
            },
            {
              "name": "prompt",
              "stringValue": "={{ $json.body?.prompt || 'Open browser and run the test.' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-params",
      "name": "Set Params",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:3211/agent",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { mcp_url: $json.mcp_url, prompt: $json.prompt, task_type: $json.task_type, complexity: $json.complexity, model_override: $json.model_override } }}"
      },
      "id": "exec-runner",
      "name": "Call MCP Runner Server",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300],
      "notes": "Calls tools/mcp-runner/server.mjs (HTTP) to run the agent without using ExecuteCommand node."
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Set Params", "type": "main", "index": 0 }]]
    },
    "Set Params": {
      "main": [[{ "node": "Call MCP Runner Server", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [{ "name": "AI-Native" }, { "name": "MCP" }, { "name": "BrowserTest" }]
}


