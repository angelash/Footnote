{
  "name": "AI-Native Cursor CLI Execution (Windows -> WSL Proxy)",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "task_pack_path",
              "stringValue": "design/ai-native/03_taskpacks/T-0001_c0_z1_dialogue.md"
            },
            {
              "name": "role",
              "stringValue": "L3_writer"
            },
            {
              "name": "task_type",
              "stringValue": "doc"
            },
            {
              "name": "complexity",
              "stringValue": "normal"
            },
            {
              "name": "model_override",
              "stringValue": "auto"
            },
            {
              "name": "project_root",
              "stringValue": "/home/shash/work/Footnote"
            }
          ]
        },
        "options": {}
      },
      "id": "set-task-params",
      "name": "Set Task Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [470, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3210/fixed-flow",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { task_pack_path: $json.task_pack_path, role: $json.role, task_type: $json.task_type, complexity: $json.complexity, model_override: $json.model_override, project_root: $json.project_root } }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "call-runner",
      "name": "Call WSL Runner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [690, 300],
      "notes": "WSL Runner (port 3210) handles all exec commands: cursor-agent, git, npm validate, etc."
    },
    {
      "parameters": {
        "jsCode": "// Parse runner response\nconst response = $input.first().json;\n\nreturn {\n  json: {\n    run_id: response.run_id || 'unknown',\n    task_id: response.task_id || $('Set Task Parameters').first().json?.task_pack_path,\n    ok: response.ok || false,\n    stage: response.stage || 0,\n    logs_dir: response.logs_dir || '',\n    status: response.ok ? 'COMPLETED' : 'FAILED',\n    message: response.ok ? 'Task completed via WSL Runner' : (response.error || 'Unknown error')\n  }\n};"
      },
      "id": "parse-result",
      "name": "Parse Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [910, 300]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Set Task Parameters", "type": "main", "index": 0 }]]
    },
    "Set Task Parameters": {
      "main": [[{ "node": "Call WSL Runner", "type": "main", "index": 0 }]]
    },
    "Call WSL Runner": {
      "main": [[{ "node": "Parse Result", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [{ "name": "AI-Native" }, { "name": "Cursor-CLI" }, { "name": "Windows-WSL-Proxy" }],
  "versionId": "cursor-cli-proxy-v1"
}
